  <bpmn:collaboration id="_Collaboration_3" name="İzin İşlemleri">
    <bpmn:extensionElements>
      <camunda:properties>
        <camunda:property name="menu_category" value="hidden" />
      </camunda:properties>
    </bpmn:extensionElements>
    <bpmn:participant id="_Participant_3" name="İzin İşlemleri" processRef="izin" />
  </bpmn:collaboration>
  <bpmn:process id="izin" name="İzin İşlemleri" isExecutable="false">
    <bpmn:laneSet id="LaneSet_2" name="Lane Set 2">
      <bpmn:lane id="personel" name="personel">
        <bpmn:flowNodeRef>kaydet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>izin_bilgileri_goster</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>izin_ekle_form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>personel_izin_listele</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>basla</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:sequenceFlow id="SequenceFlow_1" name="" sourceRef="basla" targetRef="izin_bilgileri_goster" />
    <bpmn:serviceTask id="kaydet" name="Kaydet" camunda:class="personel.izin.IzinIslemleri.kaydet">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="SequenceFlow_25" name="" sourceRef="kaydet" targetRef="izin_bilgileri_goster" />
    <bpmn:userTask id="izin_bilgileri_goster" name="İzin Bilgileri Listele" camunda:assignee="personel.izin.IzinIslemleri.goster">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_25</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="SequenceFlow_5" name="" sourceRef="izin_bilgileri_goster" targetRef="ExclusiveGateway_1" />
    <bpmn:sequenceFlow id="SequenceFlow_8" name="" sourceRef="ExclusiveGateway_1" targetRef="izin_ekle_form">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[flow == 'yeni_izin']]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_24" name="" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_3" />
    <bpmn:userTask id="izin_ekle_form" name="İzin Ekle" camunda:assignee="personel.izin.IzinIslemleri.izin_form">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="SequenceFlow_12" name="" sourceRef="izin_ekle_form" targetRef="kaydet" />
    <bpmn:userTask id="personel_izin_listele" name="İzin Listele" camunda:assignee="personel.izin.IzinIslemleri.izin_listele">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="SequenceFlow_2" name="" sourceRef="personel_izin_listele" targetRef="izin_bilgileri_goster" />
    <bpmn:sequenceFlow id="SequenceFlow_3" name="" sourceRef="ExclusiveGateway_1" targetRef="personel_izin_listele">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[flow=='izin_listele']]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:startEvent id="basla">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="ExclusiveGateway_1" default="SequenceFlow_24">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_24</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_3">
      <bpmn:incoming>SequenceFlow_24</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
