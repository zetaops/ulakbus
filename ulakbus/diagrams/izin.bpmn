        <bpmn2:flowNodeRef>EndEvent_3</bpmn2:flowNodeRef>
      </bpmn2:lane>
    </bpmn2:laneSet>
    <bpmn2:sequenceFlow id="SequenceFlow_1" name="" sourceRef="basla" targetRef="izin_bilgileri_goster" />
    <bpmn2:serviceTask id="kaydet" name="Kaydet" camunda:class="personel.izin.IzinIslemleri.kaydet">
      <bpmn2:incoming>SequenceFlow_12</bpmn2:incoming>
      <bpmn2:outgoing>SequenceFlow_25</bpmn2:outgoing>
    </bpmn2:serviceTask>
    <bpmn2:sequenceFlow id="SequenceFlow_25" name="" sourceRef="kaydet" targetRef="izin_bilgileri_goster" />
    <bpmn2:userTask id="izin_bilgileri_goster" name="İzin Bilgileri Listele" camunda:assignee="personel.izin.IzinIslemleri.goster">
      <bpmn2:incoming>SequenceFlow_1</bpmn2:incoming>
      <bpmn2:incoming>SequenceFlow_25</bpmn2:incoming>
      <bpmn2:incoming>SequenceFlow_2</bpmn2:incoming>
      <bpmn2:outgoing>SequenceFlow_5</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:sequenceFlow id="SequenceFlow_5" name="" sourceRef="izin_bilgileri_goster" targetRef="ExclusiveGateway_1" />
    <bpmn2:sequenceFlow id="SequenceFlow_8" name="" sourceRef="ExclusiveGateway_1" targetRef="izin_ekle_form">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression"><![CDATA[flow == 'yeni_izin']]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="SequenceFlow_24" name="" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_3" />
    <bpmn2:userTask id="izin_ekle_form" name="İzin Ekle" camunda:assignee="personel.izin.IzinIslemleri.izin_form">
      <bpmn2:incoming>SequenceFlow_8</bpmn2:incoming>
      <bpmn2:outgoing>SequenceFlow_12</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:sequenceFlow id="SequenceFlow_12" name="" sourceRef="izin_ekle_form" targetRef="kaydet" />
    <bpmn2:userTask id="personel_izin_listele" name="İzin Listele" camunda:assignee="personel.izin.IzinIslemleri.izin_listele">
      <bpmn2:incoming>SequenceFlow_3</bpmn2:incoming>
      <bpmn2:outgoing>SequenceFlow_2</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:sequenceFlow id="SequenceFlow_2" name="" sourceRef="personel_izin_listele" targetRef="izin_bilgileri_goster" />
    <bpmn2:sequenceFlow id="SequenceFlow_3" name="" sourceRef="ExclusiveGateway_1" targetRef="personel_izin_listele">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression"><![CDATA[flow=='izin_listele']]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:startEvent id="basla">
      <bpmn2:outgoing>SequenceFlow_1</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:exclusiveGateway id="ExclusiveGateway_1" default="SequenceFlow_24">
      <bpmn2:incoming>SequenceFlow_5</bpmn2:incoming>
      <bpmn2:outgoing>SequenceFlow_8</bpmn2:outgoing>
      <bpmn2:outgoing>SequenceFlow_24</bpmn2:outgoing>
      <bpmn2:outgoing>SequenceFlow_3</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:endEvent id="EndEvent_3">
      <bpmn2:incoming>SequenceFlow_24</bpmn2:incoming>
    </bpmn2:endEvent>
  </bpmn2:process>
